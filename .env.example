# ============================================
# Brawl Lookup Pro - Variáveis de Ambiente
# ============================================

# ─── Brawl Stars API ────────────────────────
# Token da API oficial do Brawl Stars
# Obtenha em: https://developer.brawlstars.com/
BRAWL_TOKEN=

# ─── Banco de Dados ─────────────────────────
# URL de conexão MySQL
# Formato: mysql://usuario:senha@host:porta/database
DATABASE_URL=mysql://root:password@localhost:3306/brawl_lookup_pro

# ─── Servidor ───────────────────────────────
# Porta do servidor (padrão: 3000)
PORT=3000

# Chave secreta para acessar a rota de detecção de IP (/ip?key=sua_chave)
# Use uma string aleatória forte e única. Exemplo: MinhaChaveSecretaIP123!@#
ADMIN_IP_KEY=sua_chave_secreta_aqui

# Ambiente de execução (development ou production)
NODE_ENV=development

# ─── OAuth Manus (Autenticação) ─────────────
# Credenciais OAuth para autenticação de usuários
# Obtenha em: https://manus.im/
MANUS_OAUTH_CLIENT_ID=
MANUS_OAUTH_CLIENT_SECRET=

# OpenID do proprietário (admin)
OWNER_OPEN_ID=

# ─── JWT (JSON Web Token) ───────────────────
# Chave secreta para assinar e verificar JWTs. Use uma string aleatória forte e única.
# Exemplo: MinhaChaveJWTSecretaMuitoForte123!@#
JWT_SECRET=

# ─── Notificações (Opcional) ────────────────
# Para receber notificações de marcos de troféus
NOTIFICATION_WEBHOOK_URL=

# ─── AWS S3 (Opcional) ──────────────────────
# Para upload de arquivos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ─── LLM (Opcional) ─────────────────────────
# Para funcionalidades de IA
OPENAI_API_KEY=
